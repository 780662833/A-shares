# ---------------------------------------------------------------------------
# A-shares 量化系统环境变量示例
# 用法：cp .env.example .env 后按需修改；.env 已被 .gitignore 排除，勿提交。
# 加载方式（任选其一）：
#   set -a; source .env; set +a        # shell
#   EnvironmentFile=/path/to/.env      # systemd
#   docker run --env-file .env ...     # docker
# 说明：程序仅通过 os.Getenv 读取 ASHARE_* 变量，未设置时一律使用代码内置
#       默认值（见 internal/pool.DefaultConfig 与 cmd/main.go 头部注释）。
# ---------------------------------------------------------------------------

# ---- 进程入口（cmd/main.go）----
ASHARE_DB_PATH=./data/trading.db          # SQLite 文件路径
ASHARE_GATEWAY_URL=http://127.0.0.1:8000  # Python 数据网关地址
ASHARE_HTTP_ADDR=:8080                    # 手动触发服务监听地址（"off" 禁用）
ASHARE_WATCHLIST=000001,600519            # 候选股票池，逗号分隔（动态模式下作人工白名单）

# ---- 动态自选股池 / 池生成 ----
ASHARE_DYNAMIC_WATCHLIST=0                # =1 启用动态池模式（watchlist_items 表为主来源）
ASHARE_WATCHLIST_MAX=100                  # 动态池参与粗筛的最大股票数（持仓股不占配额）
ASHARE_CRON_WATCHLIST="0 15 * * 1-5"      # 动态池更新 cron
ASHARE_POOL_SOURCE=python                 # go | python（灰度开关；go 失败自动回退 python）
ASHARE_POOL_TIMEOUT=6m                    # Go 原生池单次生成超时

# ---- LLM 接入（未配置时以降级模式运行，跳过 LLM 决策并记录告警）----
ASHARE_API_KEY=                           # 密钥仅放本地 .env，切勿写入仓库
ASHARE_MODEL=gpt-4o-mini
ASHARE_LLM_BASE_URL=https://api.openai.com/v1

# ---- 精筛管线（internal/pool.Config，覆盖 DefaultConfig）----
ASHARE_REFINE_ENABLED=true                # 资格筛选总开关（QualifyEnabled）
ASHARE_MIN_LISTED_DAYS=120                # 最短上市天数
ASHARE_REQUIRE_POSITIVE_EPS=true          # 要求 EPS 为正
ASHARE_MIN_ROE=0                          # 最低 ROE
ASHARE_RS_ENABLED=true                    # 相对强度开关
ASHARE_RS_WINDOW=60                       # 单窗口 RS 回看期
ASHARE_RS_SHORT_WINDOW=20                 # 双窗口 RS：短窗
ASHARE_RS_LONG_WINDOW=60                  # 双窗口 RS：长窗
ASHARE_RS_SHORT_WEIGHT=60                 # 短窗权重 %
ASHARE_RS_BENCHMARK=000300                # RS 基准指数
ASHARE_RS_TOPK=0                          # RS Top-K（0 = 不截断）
ASHARE_RS_CONCURRENCY=6                   # RS 并发度

# ---- 流动性过滤与交易容量 ----
ASHARE_LIQ_ENABLED=true                   # 流动性门槛开关（liquidityScreen 语义：
                                          # err != nil 或集合为空 -> 不设门槛退化）
ASHARE_MIN_ADV20_STOCK=                   # 个股 20 日均成交额下限（留空用契约默认）
ASHARE_MIN_ADV20_ETF=                     # ETF 20 日均成交额下限（留空用契约默认）
ASHARE_PLAN_NOTIONAL=0                    # 计划名义金额（0 -> UNCHECKED）
ASHARE_MAX_PARTICIPATION_PCT=1.0          # 参与率上限 %

# ---- 其他 cron 任务 ----
ASHARE_CRON_REFRESH=                      # czsc 缓存增量预热 cron（留空用内置默认）
